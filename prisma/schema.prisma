// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DIRECTOR
  TEACHER
  STUDENT
}

model School {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)

  users     User[]
  courses   Course[]
  classes   ClassRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  school    School  @relation(fields: [tenantId], references: [id])

  name      String
  email     String
  password  String
  role      UserRole

  teacherClasses TeacherOnClass[]
  studentClasses StudentOnClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, tenantId])
}

model Course {
  id        String   @id @default(uuid())
  tenantId  String
  school    School  @relation(fields: [tenantId], references: [id])

  name      String
  description String?

  classes   ClassRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassRoom {
  id        String   @id @default(uuid())
  tenantId  String
  school    School  @relation(fields: [tenantId], references: [id])

  courseId  String
  course    Course  @relation(fields: [courseId], references: [id])

  name      String
  year      Int

  teachers  TeacherOnClass[]
  students  StudentOnClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeacherOnClass {
  id        String @id @default(uuid())
  tenantId  String

  teacherId String
  classId   String

  teacher   User @relation(fields: [teacherId], references: [id])
  class     ClassRoom @relation(fields: [classId], references: [id])

  @@unique([teacherId, classId])
}

model StudentOnClass {
  id        String @id @default(uuid())
  tenantId  String

  studentId String
  classId   String

  student   User @relation(fields: [studentId], references: [id])
  class     ClassRoom @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
}


